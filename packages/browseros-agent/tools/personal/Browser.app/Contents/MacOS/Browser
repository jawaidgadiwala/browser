#!/bin/bash
# Launcher app for the personal Browser stack. Runs `bun run personal:start` from the repo.
set -euo pipefail
cd "$(dirname "$0")/../../../.."
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin:$HOME/.cargo/bin:$PATH"
LOG="$HOME/Library/Logs/Browser/launcher.log"; mkdir -p "$(dirname "$LOG")"
exec bun run personal:start >>"$LOG" 2>&1
