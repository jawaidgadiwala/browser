{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/server/src/index.ts",
    "apps/server/src/compiled-bootstrap.ts",
    "apps/claw-onboard/src/main.tsx",
    "apps/app-onboard/src/main.tsx",
    "apps/app/entrypoints/app/main.tsx",
    "apps/app/entrypoints/sidepanel/main.tsx",
    "apps/app/entrypoints/background/index.ts",
    "apps/app/entrypoints/offscreen/main.ts",
    "apps/app/entrypoints/content.ts",
    "apps/app/entrypoints/auth.content/index.ts",
    "apps/app/entrypoints/glow.content/index.ts",
    "apps/app/entrypoints/selection.content.ts",
    // The cockpit extension's WXT entrypoints. Without them nothing in
    // apps/claw-app is reachable except from its tests, which reported the
    // whole app as dead code.
    "apps/claw-app/entrypoints/background.ts",
    "apps/claw-app/entrypoints/newtab/main.tsx",
    "apps/claw-app/entrypoints/recorder.content.ts",
    "scripts/run-bun-test.ts",
    "scripts/dev/inspect-ui.ts",
    "scripts/patch-windows-exe.ts",
    "tools/personal/build.ts",
    "tools/personal/start.ts",
    "tools/personal/stop.ts"
  ],
  "ignoreDependencies": [
    "tailwind-scrollbar-hide",
    "tw-animate-css",
    "@tailwindcss/typography",
    "pino-pretty",
    "dotenv",
    "picocolors",
    "@browseros/cdp-protocol",
    "@graphql-typed-document-node/core",
    // Tool dependencies with no import site: `wxt dev`/`wxt zip` shell out to
    // web-ext, and the onboarding video renders through the Remotion CLI.
    "web-ext",
    "@remotion/bundler",
    "@remotion/renderer",
    // Declared by apps/server so the bundled binary keeps resolving them, but
    // only imported from the workspace packages the server depends on.
    "jsonc-parser",
    "@modelcontextprotocol/hono",
    "zod-to-json-schema"
  ],
  "ignoreUnresolvedImports": [
    "@/assets/**",
    "@/generated/graphql/**",
    "@/styles/global.css",
    // WXT's virtual auto-import module. It only exists inside the generated
    // .wxt/ directory, which ignorePatterns excludes.
    "#imports"
  ],
  "ignorePatterns": [
    "**/*.d.ts",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.css",
    "**/.wxt/**",
    "**/.output/**",
    "**/coverage/**",
    "**/tmp/**",
    ".scripts/**",
    "apps/app/schema/**",
    "apps/cli/**",
    "apps/app/assets/**",
    "apps/app/generated/**",
    "apps/app/public/**",
    "apps/server/src/lib/db/migrations/**",
    "packages/cdp-protocol/src/generated/**",
    ".agents/skills/**",
    ".claude/skills/**"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unused-optional-dependencies": "warn",
    "unused-enum-members": "warn",
    // Opt-in API-hygiene rule (`fallow dead-code --private-type-leaks` to see
    // them). Every app surface here keeps component `Props` and other
    // single-file shapes module-private, so the rule only ever fires on ~90
    // upstream files, and satisfying it by exporting those types just trades
    // the finding for an unused-type one. Off until the convention changes.
    "private-type-leaks": "off",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "circular-dependencies": "warn",
    "unused-class-members": "off",
    "duplicate-exports": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/tests/**",
        "**/*.config.ts",
        "**/codegen.ts"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    {
      "files": [
        "apps/app/components/ui/**",
        "apps/app/components/ai-elements/**",
        "apps/app-onboard/src/components/ui/**",
        // Vendored component libraries (shadcn primitives, ai-elements). They
        // ship whole, so unexercised pieces are expected, not dead code.
        "apps/claw-app/components/ui/**",
        "apps/claw-app/components/ai-elements/**",
        "apps/claw-onboard/src/components/ui/**"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off",
        "unused-types": "off",
        "private-type-leaks": "off"
      }
    }
  ]
}
